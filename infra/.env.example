# Copy to infra/.env (gitignored) — never commit real values here.
POSTGRES_PASSWORD=changeme

# Application roles created by db/migrations/002_roles.sh (docs/06_backend_schema.md §3).
# copilot_readonly: Text-to-SQL agent / db_query MCP tool. copilot_app: Spring Boot auth + audit.
COPILOT_READONLY_PASSWORD=changeme
COPILOT_APP_PASSWORD=changeme

# Optional. Without it, ai_service's LLM calls degrade gracefully (partial:true
# responses) rather than failing to start — see ai/llm_client.py.
LLM_PRIMARY_API_KEY=

# Optional — defaults to a dev-only value if unset (backend-api/src/main/resources/application.yml).
# Override with a real secret for anything beyond local docker compose.
JWT_SECRET=
