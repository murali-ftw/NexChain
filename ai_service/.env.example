# Copy to ai_service/.env (gitignored).

# Tool layer -> Postgres (P2.6). Connects as copilot_readonly (db/migrations/002_roles.sh).
AI_SERVICE_DATABASE_URL=postgresql://copilot_readonly:changeme@localhost:5432/nexchain
AI_SERVICE_DB_TIMEOUT_SECONDS=5

# Tool layer -> mock enterprise APIs (P2.4, mock_apis/ on port 8000).
MOCK_API_BASE_URL=http://localhost:8000
MOCK_API_TIMEOUT_SECONDS=5
