<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- requestId/userId come from MDC (RequestCorrelationFilter); "-" when absent
         (startup logs, scheduled tasks) so the field is always present and greppable. -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{36} [requestId=%X{requestId:--}, userId=%X{userId:--}] - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Third-party frameworks stay at WARN by default — their INFO chatter isn't
         actionable day-to-day and would drown out this service's own lifecycle/request logs. -->
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.hibernate" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>

    <!-- com.nexchain.backend's own level is env-controlled (application.yml logging.level.*)
         so DEBUG can be switched on for this app's code alone without touching the root logger. -->

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
